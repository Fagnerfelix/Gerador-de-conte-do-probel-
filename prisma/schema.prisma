generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PartnerStatus {
  PROSPECT
  ACTIVE
  AT_RISK
  INACTIVE
}

enum OpportunityStatus {
  OPEN
  IN_PROGRESS
  WON
  LOST
}

enum VisitType {
  COMMERCIAL
  TRAINING
  SHOWROOM
  FOLLOW_UP
}

model Partner {
  id            String        @id @default(cuid())
  name          String        @unique
  city          String?
  state         String?       @default("RO")
  contactName   String?
  phone         String?
  status        PartnerStatus @default(ACTIVE)
  potential     Int           @default(3)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  visits        Visit[]
  opportunities Opportunity[]
}

model Seller {
  id        String   @id @default(cuid())
  name      String   @unique
  region    String?
  monthlyGoal Decimal? @db.Decimal(12, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  visits    Visit[]
}

model Product {
  id             String   @id @default(cuid())
  name           String   @unique
  category       String?
  firmness       Int?
  technology     String?
  benefits       String?
  objections     String?
  idealFor       String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  opportunities  Opportunity[]
}

model Opportunity {
  id          String            @id @default(cuid())
  title       String
  value       Decimal?          @db.Decimal(12, 2)
  status      OpportunityStatus @default(OPEN)
  priority    Int               @default(3)
  nextAction  String?
  dueDate     DateTime?
  partnerId   String
  productId   String?
  partner     Partner           @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Visit {
  id          String    @id @default(cuid())
  type        VisitType @default(COMMERCIAL)
  occurredAt  DateTime  @default(now())
  summary     String
  nextStep    String?
  partnerId   String
  sellerId    String?
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  seller      Seller?   @relation(fields: [sellerId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
}

model SleepDiagnosis {
  id              String   @id @default(cuid())
  customerName    String?
  sleepPosition   String
  firmnessChoice  String
  usage           String
  sleepsWithPartner Boolean @default(false)
  heatSensitivity String
  painComplaint   String?
  recommendation  String
  rationale       String
  createdAt       DateTime @default(now())
}
